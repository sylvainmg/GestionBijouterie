<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:vm="using:BijouterieApp.App.ViewModels"
             x:Class="BijouterieApp.App.Views.AccueilView"
             x:DataType="vm:AccueilViewModel">
    <Grid Background="{StaticResource SolidBackgroundFillColorBase}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="{Binding MessageBienvenue}"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextFillColorPrimary}" />
            <TextBlock Text="{Binding DateHeure}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextFillColorSecondary}" />
            <TextBlock Text="Gestion Bijouterie v1.0"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextFillColorTertiary}"
                       Margin="0,32,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
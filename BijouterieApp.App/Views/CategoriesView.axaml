<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:vm="using:BijouterieApp.App.ViewModels"
             x:Class="BijouterieApp.App.Views.CategoriesView"
             x:DataType="vm:CategoriesViewModel">
    <Grid Background="{StaticResource SolidBackgroundFillColorBase}">
        <TextBlock Text="{Binding Titre}"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextFillColorPrimary}" />
    </Grid>
</UserControl>
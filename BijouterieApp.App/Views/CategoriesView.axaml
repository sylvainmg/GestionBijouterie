<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:vm="using:BijouterieApp.App.ViewModels"
             x:Class="BijouterieApp.App.Views.CategoriesView"
             x:DataType="vm:CategoriesViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Gestion des Catégories" FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource TextFillColorPrimary}" />
      <TextBox PlaceholderText="Rechercher une catégorie..."
               Text="{Binding Recherche}"
               UseFloatingPlaceholder="False" />
    </StackPanel>

    <DockPanel>
      <Border DockPanel.Dock="Right" Width="320" Margin="16,0,0,0"
              IsVisible="{Binding EstEnEdition}"
              Background="{StaticResource CardBackgroundFillColorDefault}"
              BorderBrush="{StaticResource CardStrokeColorDefault}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12" VerticalAlignment="Top">
          <TextBlock Text="Nouvelle catégorie"
                     FontWeight="SemiBold" FontSize="16"
                     Foreground="{StaticResource TextFillColorPrimary}" />
          <TextBox PlaceholderText="Nom *" Text="{Binding NomSaisi}" />
          <TextBox PlaceholderText="Description (optionnelle)"
                   Text="{Binding DescriptionSaisie}"
                   AcceptsReturn="True" MinHeight="80"
                   TextWrapping="Wrap" />
          <TextBlock Text="{Binding MessageErreur}"
                     Foreground="{StaticResource SystemErrorTextColor}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding AnnulerCommand}" Content="Annuler"
                    Background="{StaticResource SolidBackgroundFillColorTertiary}" />
            <Button Command="{Binding EnregistrerCommand}" Content="Enregistrer"
                    Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Border>

      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Command="{Binding NouveauCommand}" Content="Nouveau"
                  Classes="accent" />
          <Button Command="{Binding ModifierCommand}" Content="Modifier" />
          <Button Command="{Binding SupprimerCommand}" Content="Supprimer"
                  Background="{StaticResource SystemErrorBackgroundColor}"
                  Foreground="{StaticResource SystemErrorTextColor}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding CategoriesFiltrees}"
                  SelectedItem="{Binding CategorieSelectionnee}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{StaticResource CardBackgroundFillColorDefault}"
                  BorderBrush="{StaticResource CardStrokeColorDefault}"
                  BorderThickness="1"
                  CornerRadius="4"
                  HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </DockPanel>
  </DockPanel>
</UserControl>
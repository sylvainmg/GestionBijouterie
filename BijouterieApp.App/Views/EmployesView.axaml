<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             xmlns:vm="using:BijouterieApp.App.ViewModels"
             xmlns:enums="using:BijouterieApp.Core.Enums"
             x:Class="BijouterieApp.App.Views.EmployesView"
             x:DataType="vm:EmployesViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Gestion des Employés" FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource TextFillColorPrimary}" />
      <TextBox PlaceholderText="Rechercher par nom, matricule, login, fonction..."
               Text="{Binding Recherche}"
               UseFloatingPlaceholder="False" />
    </StackPanel>

    <DockPanel>
      <Border DockPanel.Dock="Right" Width="340" Margin="20,0,0,0"
              IsVisible="{Binding EstEnEdition}"
              Background="{StaticResource CardBackgroundFillColorDefault}"
              BorderBrush="{StaticResource CardStrokeColorDefault}"
              BorderThickness="1" CornerRadius="8" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" VerticalAlignment="Top">
            <TextBlock Text="Formulaire employé" Classes="formTitle" />

            <TextBox PlaceholderText="Nom *" Text="{Binding NomSaisi}" />
            <TextBox PlaceholderText="Prénom *" Text="{Binding PrenomSaisi}" />
            <TextBox PlaceholderText="Téléphone" Text="{Binding TelephoneSaisi}" />
            <TextBox PlaceholderText="Adresse" Text="{Binding AdresseSaisie}" />
            <TextBox PlaceholderText="Fonction" Text="{Binding FonctionSaisie}" />
            <TextBox PlaceholderText="Login *" Text="{Binding LoginSaisi}" />
            <TextBox PlaceholderText="Mot de passe"
                     Text="{Binding MotDePasseSaisi}"
                     PasswordChar="*" />

            <TextBlock Text="Rôle" Classes="fieldLabel" />
            <ComboBox SelectedItem="{Binding RoleSelectionne}">
              <enums:RoleEmploye>Administrateur</enums:RoleEmploye>
              <enums:RoleEmploye>Caissier</enums:RoleEmploye>
            </ComboBox>

            <TextBlock Text="{Binding MessageErreur}" Classes="errorMessage" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Command="{Binding AnnulerCommand}" Content="Annuler"
                      Classes="cancel" />
              <Button Command="{Binding EnregistrerCommand}" Content="Enregistrer"
                      Classes="accent" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Command="{Binding NouveauCommand}" Content="Nouveau"
                  Classes="accent" />
          <Button Command="{Binding ModifierCommand}" Content="Modifier"
                  Classes="neutral" />
          <Button Command="{Binding SupprimerCommand}" Content="Supprimer"
                  Classes="danger" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding EmployesFiltres}"
                  SelectedItem="{Binding EmployeSelectionne}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="36"
                  Background="{StaticResource CardBackgroundFillColorDefault}"
                  BorderBrush="{StaticResource CardStrokeColorDefault}"
                  BorderThickness="1"
                  CornerRadius="4"
                  HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="90" />
            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*" />
            <DataGridTextColumn Header="Fonction" Binding="{Binding Fonction}" Width="120" />
            <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="100" />
            <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </DockPanel>
  </DockPanel>
</UserControl>

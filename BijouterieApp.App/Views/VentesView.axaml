<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             xmlns:vm="using:BijouterieApp.App.ViewModels"
             x:Class="BijouterieApp.App.Views.VentesView"
             x:DataType="vm:VentesViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Gestion des Ventes" FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource TextFillColorPrimary}" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBox PlaceholderText="Rechercher une vente..." Text="{Binding Recherche}"
                 Width="300" UseFloatingPlaceholder="False" />
        <Button Command="{Binding NouvelleVenteCommand}" Content="Nouvelle vente"
                Classes="accent" />
        <Button Command="{Binding GenererFactureCommand}" Content="Facture PDF"
                IsVisible="{Binding VenteSelectionnee, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Command="{Binding GenererListeVentesPeriodeCommand}" Content="Rapport du mois" />
      </StackPanel>
    </StackPanel>

    <DockPanel>
      <!-- Panneau création de vente -->
      <Border DockPanel.Dock="Right" Width="380" Margin="16,0,0,0"
              IsVisible="{Binding EstEnEdition}"
              Background="{StaticResource CardBackgroundFillColorDefault}"
              BorderBrush="{StaticResource CardStrokeColorDefault}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" VerticalAlignment="Top">
            <TextBlock Text="Nouvelle vente"
                       FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource TextFillColorPrimary}" />

            <TextBlock Text="Client *" Foreground="{StaticResource TextFillColorSecondary}" FontSize="12" />
            <ComboBox ItemsSource="{Binding Clients}"
                      SelectedItem="{Binding ClientSelectionne}"
                      DisplayMemberBinding="{Binding Prenom}"
                      PlaceholderText="Sélectionner un client" />

            <TextBlock Text="Ajouter un bijou" Foreground="{StaticResource TextFillColorSecondary}" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding BijouxDisponibles}"
                        SelectedItem="{Binding BijouSelectionne}"
                        DisplayMemberBinding="{Binding Nom}"
                        PlaceholderText="Choisir un bijou" Width="240" />
              <Button Command="{Binding AjouterLigneCommand}" Content="+"
                      Padding="12,4" Classes="accent" />
            </StackPanel>

            <DataGrid ItemsSource="{Binding LignesEnEdition}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      MaxHeight="200"
                      Background="Transparent"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Bijou" Binding="{Binding Bijou.Nom}" Width="*" />
                <DataGridTextColumn Header="Prix Unit." Binding="{Binding PrixUnitaire, StringFormat='{}{0:N0}'}" Width="90" />
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="50" />
                <DataGridTextColumn Header="Sous-total" Binding="{Binding SousTotal, StringFormat='{}{0:N0}'}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Remise (Ar):" VerticalAlignment="Center"
                           Foreground="{StaticResource TextFillColorSecondary}" />
                <NumericUpDown Value="{Binding RemiseSaisie}" Minimum="0" Maximum="9999999"
                               Width="130" FormatString="N0" />
              </StackPanel>
            </StackPanel>

            <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextFillColorPrimary}">
              <TextBlock.Text>
                <MultiBinding StringFormat="Total : {0:N0} Ar">
                  <Binding Path="TotalVente" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>

            <TextBlock Text="{Binding MessageErreur}"
                       Foreground="{StaticResource SystemErrorTextColor}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Command="{Binding AnnulerCommand}" Content="Annuler"
                      Background="{StaticResource SolidBackgroundFillColorTertiary}" />
              <Button Command="{Binding ValiderVenteCommand}" Content="Valider la vente"
                      Classes="accent" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Liste des ventes -->
      <DataGrid ItemsSource="{Binding VentesFiltrees}"
                SelectedItem="{Binding VenteSelectionnee}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                Background="{StaticResource CardBackgroundFillColorDefault}"
                BorderBrush="{StaticResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="4"
                HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="N° Vente" Binding="{Binding Id}" Width="80" />
          <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" />
          <DataGridTextColumn Header="Client" Binding="{Binding Client.Prenom}" Width="*" />
          <DataGridTextColumn Header="Employé" Binding="{Binding Employe.Prenom}" Width="120" />
          <DataGridTextColumn Header="Total (Ar)" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="120" />
          <DataGridTextColumn Header="Remise" Binding="{Binding Remise, StringFormat='{}{0:N0}'}" Width="90" />
          <DataGridTextColumn Header="Lignes" Binding="{Binding LigneVentes.Count}" Width="60" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</UserControl>
